/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     struct TreeNode *left;
 *     struct TreeNode *right;
 * };
 */
/**
 * Note: The returned array must be malloced, assume caller calls free().
 */

void traverse(struct TreeNode* root, int* result, int* index) {
    if (!root) return;
    traverse(root->left, result, index);     // Left
    result[(*index)++] = root->val;          // Root
    traverse(root->right, result, index);    // Right
}

int* inorderTraversal(struct TreeNode* root, int* returnSize) {
    int* result = (int*)malloc(200 * sizeof(int)); // Preallocate for up to 200 nodes
    int index = 0;
    traverse(root, result, &index);
    *returnSize = index;
    return result;
}
